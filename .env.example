# Copy to .env and fill in. Never commit .env.
# Only GROQ_API_KEY is required. Paths, model IDs for embeddings and other
# constants live in src/boston311/config.py, not here.

# --- LLM: Groq free tier ---
# Create a free key at https://console.groq.com/keys
# Each teammate uses their own key: free limits apply per account.
GROQ_API_KEY=

LLM_PROVIDER=groq
# Use openai/gpt-oss-20b while developing; openai/gpt-oss-120b for the final eval and demo.
LLM_MODEL=openai/gpt-oss-120b

# Offline fallback, no key: install Ollama, run `ollama pull gpt-oss:20b`,
# `uv add langchain-ollama`, then set:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=gpt-oss:20b

# --- Optional: LangSmith tracing (LangChain reads these directly) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=boston311-crew-planner
