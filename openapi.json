{
  "openapi": "3.1.0",
  "info": {
    "title": "Boston 311 Crew Planner",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/intake": {
      "post": {
        "summary": "Intake",
        "operationId": "intake_api_intake_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntakeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/forecast": {
      "get": {
        "summary": "Forecast",
        "operationId": "forecast_api_forecast_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/plan": {
      "get": {
        "summary": "Plan",
        "operationId": "plan_api_plan_get",
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "base",
                "hold_flat",
                "demand_plus_20",
                "demand_minus_20",
                "snowstorm",
                "heat_wave"
              ],
              "type": "string",
              "default": "base",
              "title": "Scenario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plan/solve": {
      "post": {
        "summary": "Plan Solve",
        "operationId": "plan_solve_api_plan_solve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ask": {
      "post": {
        "summary": "Ask",
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/ToolTraceStep"
            },
            "type": "array",
            "title": "Trace"
          },
          "what_if": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SolveRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "unverified_numbers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unverified Numbers"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "trace",
          "what_if",
          "unverified_numbers"
        ],
        "title": "AskResponse"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "DepartmentForecast": {
        "properties": {
          "department": {
            "type": "string",
            "enum": [
              "PWDx",
              "BTDT",
              "PARK",
              "ISD"
            ],
            "title": "Department"
          },
          "months": {
            "items": {
              "$ref": "#/components/schemas/ForecastMonth"
            },
            "type": "array",
            "title": "Months"
          },
          "backtest_mape": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backtest Mape"
          }
        },
        "type": "object",
        "required": [
          "department",
          "months",
          "backtest_mape"
        ],
        "title": "DepartmentForecast"
      },
      "DepartmentPlan": {
        "properties": {
          "department": {
            "type": "string",
            "enum": [
              "PWDx",
              "BTDT",
              "PARK",
              "ISD"
            ],
            "title": "Department"
          },
          "months": {
            "items": {
              "$ref": "#/components/schemas/PlanMonth"
            },
            "type": "array",
            "title": "Months"
          }
        },
        "type": "object",
        "required": [
          "department",
          "months"
        ],
        "title": "DepartmentPlan"
      },
      "ForecastMonth": {
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "title": "Month"
          },
          "forecast": {
            "type": "number",
            "title": "Forecast"
          },
          "lower": {
            "type": "number",
            "title": "Lower"
          },
          "upper": {
            "type": "number",
            "title": "Upper"
          }
        },
        "type": "object",
        "required": [
          "month",
          "forecast",
          "lower",
          "upper"
        ],
        "title": "ForecastMonth"
      },
      "ForecastResult": {
        "properties": {
          "departments": {
            "items": {
              "$ref": "#/components/schemas/DepartmentForecast"
            },
            "type": "array",
            "title": "Departments"
          }
        },
        "type": "object",
        "required": [
          "departments"
        ],
        "title": "ForecastResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model"
        ],
        "title": "HealthResponse"
      },
      "IntakeRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "IntakeRequest"
      },
      "IntakeResponse": {
        "properties": {
          "requests": {
            "items": {
              "$ref": "#/components/schemas/RoutedRequest"
            },
            "type": "array",
            "title": "Requests"
          },
          "follow_up_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Follow Up Question"
          },
          "out_of_scope": {
            "type": "boolean",
            "title": "Out Of Scope"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/ToolTraceStep"
            },
            "type": "array",
            "title": "Trace"
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "requests",
          "follow_up_question",
          "out_of_scope",
          "reply",
          "trace"
        ],
        "title": "IntakeResponse",
        "description": "Messages outside the four departments come back with out_of_scope=True and no requests."
      },
      "PlanKpis": {
        "properties": {
          "total_cost": {
            "type": "number",
            "title": "Total Cost"
          },
          "overdue_cost": {
            "type": "number",
            "title": "Overdue Cost"
          },
          "on_time_pct": {
            "type": "number",
            "title": "On Time Pct"
          },
          "baseline_total_cost": {
            "type": "number",
            "title": "Baseline Total Cost"
          },
          "baseline_overdue_cost": {
            "type": "number",
            "title": "Baseline Overdue Cost"
          },
          "baseline_on_time_pct": {
            "type": "number",
            "title": "Baseline On Time Pct"
          }
        },
        "type": "object",
        "required": [
          "total_cost",
          "overdue_cost",
          "on_time_pct",
          "baseline_total_cost",
          "baseline_overdue_cost",
          "baseline_on_time_pct"
        ],
        "title": "PlanKpis",
        "description": "total_cost = crew cost + release fees + overdue penalties; overdue_cost is the penalty part.\n\nThe baseline holds January crews flat all year."
      },
      "PlanMonth": {
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "title": "Month"
          },
          "active_crews": {
            "type": "integer",
            "title": "Active Crews"
          },
          "hires": {
            "type": "integer",
            "title": "Hires"
          },
          "releases": {
            "type": "integer",
            "title": "Releases"
          },
          "seasonal": {
            "type": "integer",
            "title": "Seasonal"
          },
          "capacity": {
            "type": "number",
            "title": "Capacity"
          },
          "forecast": {
            "type": "number",
            "title": "Forecast"
          },
          "on_time_pct": {
            "type": "number",
            "title": "On Time Pct"
          },
          "cost": {
            "type": "number",
            "title": "Cost"
          }
        },
        "type": "object",
        "required": [
          "month",
          "active_crews",
          "hires",
          "releases",
          "seasonal",
          "capacity",
          "forecast",
          "on_time_pct",
          "cost"
        ],
        "title": "PlanMonth"
      },
      "PlanResult": {
        "properties": {
          "scenario": {
            "type": "string",
            "title": "Scenario"
          },
          "departments": {
            "items": {
              "$ref": "#/components/schemas/DepartmentPlan"
            },
            "type": "array",
            "title": "Departments"
          },
          "kpis": {
            "$ref": "#/components/schemas/PlanKpis"
          }
        },
        "type": "object",
        "required": [
          "scenario",
          "departments",
          "kpis"
        ],
        "title": "PlanResult"
      },
      "RoutedRequest": {
        "properties": {
          "request_type": {
            "type": "string",
            "title": "Request Type"
          },
          "department": {
            "type": "string",
            "enum": [
              "PWDx",
              "BTDT",
              "PARK",
              "ISD"
            ],
            "title": "Department"
          },
          "queue": {
            "type": "string",
            "title": "Queue"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "details": {
            "type": "string",
            "title": "Details"
          },
          "typical_days_to_close": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Typical Days To Close"
          }
        },
        "type": "object",
        "required": [
          "request_type",
          "department",
          "queue",
          "location",
          "details",
          "typical_days_to_close"
        ],
        "title": "RoutedRequest"
      },
      "SolveRequest": {
        "properties": {
          "demand_multiplier": {
            "type": "number",
            "maximum": 1.5,
            "minimum": 0.5,
            "title": "Demand Multiplier",
            "default": 1.0
          },
          "shock": {
            "type": "string",
            "enum": [
              "none",
              "snowstorm",
              "heat_wave"
            ],
            "title": "Shock",
            "default": "none"
          },
          "on_time_target": {
            "type": "number",
            "maximum": 0.99,
            "minimum": 0.5,
            "title": "On Time Target",
            "default": 0.9
          }
        },
        "type": "object",
        "title": "SolveRequest"
      },
      "ToolTraceStep": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "tool",
          "args",
          "summary"
        ],
        "title": "ToolTraceStep"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
